# PipeBot Frontend Environment Variables
# Copy to .env.local for local overrides. Do NOT commit production credentials or secrets.

# Backend REST API endpoint (Python FastAPI server)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Backend WebSocket endpoint for duplex telemetry stream
VITE_WS_URL=ws://127.0.0.1:8000/ws

# ESP32-CAM MJPEG optical feed stream URL
VITE_CAMERA_STREAM_URL=http://192.168.4.1/stream

# Application Mode: disconnected | demo | live
# - disconnected: Default production state with disconnected hardware & empty states
# - demo: Explicit controlled demonstration mode with sample labeled test datasets
# - live: Configured mode attempting communication with real backend endpoints
VITE_APP_MODE=disconnected

