# PipeBot Backend Configuration Template
# Copy this file to .env for local runtime configuration.
# Never commit real credentials or production secrets.

APP_NAME="PipeBot Backend"
APP_VERSION="0.1.0"
APP_ENV="development"
DEBUG=true

API_V1_PREFIX="/api/v1"

# SQLite database location (relative to backend directory or absolute)
DATABASE_URL="sqlite:///./data/pipebot.db"

# Centralized logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="INFO"

# Allowed CORS origins for frontend client access (comma-separated)
CORS_ORIGINS="http://127.0.0.1:3000,http://localhost:3000"

# Optional Device Ingestion Security Token (null/empty disables token requirement)
DEVICE_INGEST_TOKEN=""

# Inactivity timeouts (seconds) for device status evaluation
HEARTBEAT_TIMEOUT_SECONDS=5.0
TELEMETRY_STALE_TIMEOUT_SECONDS=3.0

# WebSocket concurrent connection limit
WS_MAX_CONNECTIONS=50

# Camera Stream Configuration (ESP32-CAM optical feed)
CAMERA_ID="esp32_cam_01"
CAMERA_STREAM_URL=""
CAMERA_STREAM_TYPE="mjpeg"
CAMERA_CONNECT_TIMEOUT=5.0
CAMERA_READ_TIMEOUT=5.0
CAMERA_MAX_FRAME_BYTES=1048576
CAMERA_MAX_FRAME_WIDTH=1920
CAMERA_MAX_FRAME_HEIGHT=1080
CAMERA_MAX_FPS=30.0
CAMERA_QUEUE_SIZE=10

# Media evidence storage directory (relative to backend root)
MEDIA_STORAGE_DIR="data/media"

# Vision and YOLO Inference Configuration
INFERENCE_ENABLED=false
INFERENCE_PROVIDER="unavailable"
YOLO_MODEL_PATH=""
INFERENCE_CONFIDENCE_THRESHOLD=0.5
INFERENCE_DEVICE="cpu"



